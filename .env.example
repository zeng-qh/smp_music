# 复制成 .env 后按需修改：  cp .env.example .env

# ---- 音乐目录（宿主机路径，挂进容器 /music）----
MUSIC_DIR=/vol1/music

# ---- 网页登录（不设密码会每次生成随机口令，打印在容器日志里）----
WEB_USER=admin
WEB_PASSWORD=change-me-please

# ---- 默认启用哪块声卡（按名字关键字匹配）----
# 树莓派 4B 一般：Headphones=3.5mm，vc4-hdmi-0 / vc4-hdmi-1 = 两个 HDMI
DEFAULT_CARD=Headphones

# ---- 蓝牙音箱 ----
ENABLE_BLUETOOTH=yes
# 音箱 MAC；留空则连当前已配对的默认设备。宿主机需先完成配对
BT_MAC=

# ---- 对外端口 ----
WEB_PORT=8080        # 网页控制台
STREAM_PORT=8000     # 音频流（当前访问设备播放时用）

# ---- 时区 ----
TZ=Asia/Shanghai
